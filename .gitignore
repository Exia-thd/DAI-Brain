node_modules/
dist/
*.tsbuildinfo
.env
.env.local
# Anchored to the repo root on purpose. Unanchored, `sessions/` matches a
# directory of that name at any depth -- and it did: it silently swallowed
# gateway/src/sessions/, so the pushed branch did not build from a fresh clone.
# The Gateway's own session directories default to /tmp/dai-brain-sessions and
# are outside the repo anyway; this covers the case where GATEWAY_SESSION_ROOT
# is pointed at ./sessions.
/sessions/
*.log
plugin-mcp.json
