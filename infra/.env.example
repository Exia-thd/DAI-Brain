# Copy to infra/.env and edit. docker compose reads it automatically.

# --- database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daibrain
POSTGRES_PORT=5432

# --- embeddings -----------------------------------------------------------
# hash:         offline, deterministic, lexical only. Fine to start with, but
#               recall measured on it is a floor, not a forecast.
# transformers: real sentence embeddings. Downloads a model on first use.
#
# DAI_EMBEDDING_DIMS must match the model, and it is fixed at migration time:
# changing it after data exists needs a fresh store and a re-ingest.
DAI_EMBEDDING_PROVIDER=hash
DAI_EMBEDDING_DIMS=384
# DAI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- gateway --------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_MAX_CONCURRENCY=8
GATEWAY_REQUEST_TIMEOUT_MS=300000
GATEWAY_PREFETCH_TOKENS=1000

# Exactly one of these. GATEWAY_DEV_SCOPE disables authentication entirely and
# is refused when NODE_ENV=production.
GATEWAY_JWT_SECRET=
# GATEWAY_DEV_SCOPE=acme/me/daibrain

# --- runner ---------------------------------------------------------------
# An API key rather than a subscription login: the Gateway serves whoever holds
# a token, and a subscription is issued to a person. Check Anthropic's terms
# before running this multi-user.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# --- write-back -----------------------------------------------------------
GATEWAY_WRITEBACK=true
GATEWAY_WRITEBACK_MODEL=claude-haiku-4-5-20251001
# Start strict. A low floor produced junk memories in early testing.
GATEWAY_WRITEBACK_MIN_CONFIDENCE=0.6
